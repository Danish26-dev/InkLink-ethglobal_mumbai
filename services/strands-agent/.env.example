# Inklink Strands Agent — example environment configuration.
# Copy this file to ".env" and fill in the values. NEVER commit the real .env.
# This file must only ever contain placeholders.

# Port + bind address for the agent HTTP service. Keep loopback for local dev;
# the Docker image binds 0.0.0.0.
PORT=4000
HOST=127.0.0.1

# URL of the Inklink Document Engine (inspect / process / download).
DOCUMENT_ENGINE_URL=http://localhost:5001

# Comma-separated browser origins allowed to call the agent directly.
# Leave EMPTY (recommended): the Inklink backend calls the agent server-side.
AGENT_ALLOWED_ORIGINS=

# ----------------------------------------------------------------------------
# Google Cloud Vertex AI (model provider) — required
# ----------------------------------------------------------------------------
# Authentication uses Application Default Credentials (ADC). Do NOT set an API
# key and do NOT create a service-account JSON key for local dev. Instead run:
#   gcloud auth application-default login
# Application code never reads credentials; the Google auth library resolves ADC.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=True
VERTEX_AI_MODEL_ID=gemini-2.5-flash

# Sampling temperature for planning. Keep low for deterministic plans.
MODEL_TEMPERATURE=0

# Per-call output token cap (helps limit token-per-minute usage).
VERTEX_MAX_OUTPUT_TOKENS=2048
# Gemini 2.5 "thinking" token budget.
#   -1 (default) = unset: use the model's default budget (keeps tool-calling
#        reliable). RECOMMENDED.
#   A positive value caps thinking tokens. Do NOT set 0 — it can stall the
#        tool-calling loop for gemini-2.5-flash.
VERTEX_THINKING_BUDGET=-1

# ----------------------------------------------------------------------------
# Timeouts and retries (optional; defaults shown)
# ----------------------------------------------------------------------------
# Keep ENGINE_PROCESS_TIMEOUT_MS above the engine's CONVERT_TIMEOUT (150 s) and
# below the caller's timeout for /api/edit.
ENGINE_INSPECT_TIMEOUT_MS=90000
ENGINE_PROCESS_TIMEOUT_MS=165000
AGENT_THROTTLE_RETRIES=4
AGENT_THROTTLE_DELAYS_MS=5000,12000,20000,30000

# Opt-in real-model tests (see README). Leave unset for normal runs.
# RUN_VERTEX_TESTS=1
