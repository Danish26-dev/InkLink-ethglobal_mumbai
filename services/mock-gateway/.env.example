# ═══ MOCK Inklink backend + shop gateway (LOCAL DEV ONLY) ═══
PORT=8000

# LAN address put in the shop QR so a phone can reach this machine. Set it to the IPv4 of the
# network your PHONE is on (virtual adapters are skipped, but check the printed value).
# GATEWAY_IP=192.168.1.20
# GATEWAY_MDNS=gateway-001.local
# SHOP_ID=shop_001
# GATEWAY_ID=gateway_001
# SESSION_TTL_SECONDS=900

# ── Payments (all three required, otherwise quotes offer no Hedera option) ──
# Must match the payment agent's values.
INTERNAL_API_TOKEN=
PAYMENT_EVENT_SIGNING_SECRET=
MERCHANT_ACCOUNT_ID=0.0.XXXXXXX
# Token the x402 gate presents when it asks this backend for a job's payment requirements.
BACKEND_API_TOKEN=

# Where the services live.
# AGENT_URL=http://localhost:4021
# GATE_URL=http://localhost:4022

# MOCK exchange rate, USDC per 1 INR. NOT a market rate.
# MOCK_INR_TO_USDC_RATE=0.005

# Dev-only shortcut that FAKES a settled payment. Leave off.
# MOCK_ALLOW_SIMULATE=1
