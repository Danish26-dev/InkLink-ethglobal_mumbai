# ═══ Payment Agent (INTERNAL: called by the Inklink backend, never by the app) ═══

# ── Service-to-service security (REQUIRED; the server refuses to start without them) ──
# Bearer token the Inklink backend presents when calling this service.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_TOKEN=
# HMAC-SHA256 secret shared with the backend for the settlement callback.
PAYMENT_EVENT_SIGNING_SECRET=
# x402 gate origins this agent may pay (comma-separated). Anything else is refused.
ALLOWED_RESOURCE_ORIGINS=http://localhost:4022

# ── Hedera Testnet agent wallet (NEVER commit the real .env) ──
# Dedicated testnet ECDSA account that holds and sends HTS-USDC.
# Create at https://portal.hedera.com/ (choose ECDSA). Hex or DER key both work.
HEDERA_AGENT_ACCOUNT_ID=0.0.XXXXXXX
HEDERA_AGENT_PRIVATE_KEY=                   # ECDSA private key — signing service only

# Testnet USDC (Circle). Defaults to 0.0.429274 / 6 decimals; only override if it changes.
# Mint test USDC at https://faucet.circle.com/ (select Hedera Testnet).
# HTS_USDC_TOKEN_ID=0.0.429274
# HTS_USDC_DECIMALS=6

# Merchant: the Inklink merchantId a customer allowlists, and the Hedera account that
# receives its payments. The merchant account must also be associated with USDC.
MERCHANT_ID=shop_001
MERCHANT_ACCOUNT_ID=0.0.XXXXXXX

# ── Facilitator: Blocky402 (locked). There is NO automatic fallback. ──
FACILITATOR_URL=https://api.testnet.blocky402.com

# ── HCS spend audit log (optional; a topic id, not a secret) ──
# Create once with: npm run setup:audit-topic   (submit key = agent key, no admin key)
HCS_AUDIT_TOPIC_ID=

# ── Backend integration ──
# Settlement callback (agreed endpoint). Signed with X-Inklink-Timestamp / X-Inklink-Signature.
BACKEND_EVENT_URL=http://localhost:8000/api/v1/internal/payment-settled
CALLBACK_MAX_ATTEMPTS=8

# ── Durable state: spent limits, used nonces, payments, undelivered callbacks ──
# Keep it OUT of git and OUT of a cloud-synced folder (OneDrive/Dropbox can lock it mid-write).
# The agent refuses to start if this file is corrupt rather than silently resetting limits.
# AGENT_STATE_FILE=.data/agent-state.json

# ── Ports ──
PORT=4021
GATE_PORT=4022

# ═══ x402 gate (npm run gate) ═══
# Where the gate asks the backend what a job must pay. The endpoint is PROPOSED, so the URL is
# configuration. {jobId} is substituted. If unset the gate runs in DEV MODE with a FIXED price.
# REQUIREMENTS_URL_TEMPLATE=http://localhost:8000/api/v1/internal/jobs/{jobId}/payment-requirements
# BACKEND_API_TOKEN=            # bearer token the gate presents to the backend
# EXAMPLE_PRICE_USDC=0.10       # dev mode only
