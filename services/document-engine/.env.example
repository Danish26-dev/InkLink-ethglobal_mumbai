# Inklink Document Engine configuration.
# Copy to ".env" for local use. Never commit a real .env.

# Port the FastAPI service listens on
PORT=5001

# Bind address when started with `python -m app.main`. The Docker image binds
# 0.0.0.0 itself; keep loopback for local development.
HOST=127.0.0.1

# Directory for per-job scratch files (uploads, converted, edited)
WORK_DIR=./_work

# Path to the LibreOffice "soffice" binary used for DOCX -> PDF conversion.
# Leave blank to auto-detect from PATH / standard install locations.
# Docker image: /usr/bin/soffice
SOFFICE_PATH=

# How long (seconds) a single LibreOffice conversion may run. Keep it below the
# agent's ENGINE_PROCESS_TIMEOUT_MS (165000 ms by default).
CONVERT_TIMEOUT=150

# Largest accepted upload in bytes (default 50 MB, same as the agent).
MAX_UPLOAD_BYTES=52428800

# Job directories older than this many seconds are removed automatically.
JOB_TTL_SECONDS=3600

# Comma-separated browser origins allowed to call the engine directly.
# Leave EMPTY (recommended): the engine is called server-side only.
DOCUMENT_ENGINE_ALLOWED_ORIGINS=
