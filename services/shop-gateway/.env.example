# Inklink shop gateway connector (runs on the shop computer). Copy to .env (git-ignored).
# Only OUTBOUND connections are made; nothing on the shop network is exposed.

# Public HTTPS origin of the Inklink backend (Cloud Run), no trailing slash.
BACKEND_URL=https://inklink-backend-REPLACE.asia-south1.run.app
# Same value as the backend's GATEWAY_TOKEN secret.
GATEWAY_TOKEN=
GATEWAY_ID=gateway_001

# Local printer adapter (services/local-printer-agent) on this computer.
PRINTER_AGENT_URL=http://127.0.0.1:7777
# Only if the adapter has PRINTER_AGENT_TOKEN set (recommended).
PRINTER_AGENT_TOKEN=

# Read-only status for the ESP32-S3 display. Loopback by default; set the shop
# computer's LAN address (e.g. 192.168.1.20) only if the ESP32 must reach it, and
# then set DISPLAY_TOKEN too. Never port-forward this to the internet.
DISPLAY_HOST=127.0.0.1
DISPLAY_PORT=7780
DISPLAY_TOKEN=

# Long-poll wait (1-25 s).
POLL_WAIT_SECONDS=25
