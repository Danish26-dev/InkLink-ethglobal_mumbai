# Inklink Local Printer Agent configuration.
#
# This process runs on the PRINT SHOP'S computer (the Windows machine physically
# connected to the printer). The Inklink backend calls it over localhost/LAN to
# discover printers, check availability, validate settings, and submit APPROVED
# print jobs. It is a local printer adapter, not ESP32 firmware.
# Copy to ".env" for local use; never commit a real .env.

# Port + host to bind. Default binds to loopback only (safest).
PRINTER_AGENT_PORT=7777
PRINTER_AGENT_HOST=127.0.0.1

# Optional shared token. When SET, every request (except /health) must send a
# matching `x-printer-agent-token` header. When EMPTY, only loopback (localhost)
# callers are accepted. Set a long random token if the backend runs on another
# host, and only then bind PRINTER_AGENT_HOST to a LAN address.
PRINTER_AGENT_TOKEN=

# Comma-separated browser origins allowed to call the agent. Leave EMPTY: the
# backend calls server-to-server, and any request carrying an unlisted browser
# Origin header is refused so web pages cannot drive the printer.
PRINTER_AGENT_ALLOWED_ORIGINS=

# Max PDF size accepted for a print submission (bytes). Default 50 MB.
PRINTER_AGENT_MAX_PDF_BYTES=52428800
