# Inklink backend (FastAPI) — example configuration.
# Copy to ".env" and fill in values. Never commit a real .env. Placeholders only.

PORT=8000
HOST=127.0.0.1
DATA_DIR=./data
# Browser origins. In development everything is same-origin through the dev
# server on 5173 (landing + PWA + /api proxy), so CORS is rarely needed.
BACKEND_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# ── 0G Private Computer (server-side only; never put these in a frontend env) ──
# One API key per trust mode, created at https://pc.0g.ai (Dashboard -> API Keys),
# each key set to its matching trust mode. Every request uses the key for the
# selected mode AND the header X-0G-Provider-Trust-Mode. No key is ever used for
# another mode, and a run never falls back to a weaker mode.
ZERO_G_BASE_URL=https://router-api.0g.ai/v1
ZERO_G_STANDARD_API_KEY=
ZERO_G_VERIFIED_API_KEY=
ZERO_G_PRIVATE_API_KEY=
# Mode for runs without document content (no document attached).
ZERO_G_DEFAULT_TRUST_MODE=private
# Chat model with tool calling. glm-5.3 is TeeML (private-capable) in the 0G
# catalog. Optional per-mode overrides: ZERO_G_STANDARD_MODEL_ID,
# ZERO_G_VERIFIED_MODEL_ID, ZERO_G_PRIVATE_MODEL_ID. The backend checks the
# live catalog: private needs verifiability TeeML, verified TeeML or TeeTLS.
ZERO_G_MODEL_ID=glm-5.3
# Require x_0g_trace.tee_verified=true on verified/private responses (recommended).
ZERO_G_REQUIRE_TEE_VERIFICATION=true
# Per-call timeout (seconds) and retries of the SAME trust mode on 429/502/503/timeouts.
# A retry never uses another trust mode, another key or another model.
ZERO_G_TIMEOUT_SECONDS=180
ZERO_G_MAX_RETRIES=2
ZERO_G_CATALOG_TTL_SECONDS=300
# URL the agent uses for this backend's inference gateway.
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# ── Documents ──
# Uploaded and edited files are deleted this many hours after the job's last change.
DOCUMENT_RETENTION_HOURS=24

# ── Shopkeeper accounts ──
# Accounts are created on this server: python -m app.manage create-shopkeeper --email ... --shops shop_001
# There are no default credentials. Sessions are HttpOnly cookies; only a hash is stored.
SHOP_SESSION_TTL_SECONDS=28800
# true when served over HTTPS (production).
SESSION_COOKIE_SECURE=false
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900
# Kiosk mode only: tokenless dashboard from this computer. Off by default now that login exists.
SHOP_LOCAL_ACCESS=false

# ── ETHGlobal jury demo (isolated demo shop; never prints physically) ──
JURY_DEMO_ENABLED=true
DEMO_SHOP_ID=shop_demo
JURY_SESSION_TTL_SECONDS=14400

# ── Hardware (ESP32-S3 controller / gateway) ──
# Devices report with Authorization: Bearer <DEVICE_TOKEN>. Empty = no device can report.
DEVICE_TOKEN=
DEVICE_OFFLINE_AFTER_SECONDS=60

# ── 0G Galileo testnet registries (NOT deployed yet; leave empty until they are) ──
ZERO_G_GALILEO_RPC_URL=
ZERO_G_GALILEO_CHAIN_ID=
INKLINK_SHOP_REGISTRY_ADDRESS=
INKLINK_JOB_REGISTRY_ADDRESS=
# ABI JSON files produced by the contract build (paths on this server).
INKLINK_SHOP_REGISTRY_ABI_PATH=
INKLINK_JOB_REGISTRY_ABI_PATH=
# Backend signer for registry writes. NOT the deployer key. Use a secret manager in production.
ZERO_G_GALILEO_SIGNER_PRIVATE_KEY=

# ── 0G Storage (optional; documents are never uploaded without it) ──
ZERO_G_STORAGE_INDEXER_URL=

# ── Shop identity (this backend serves one shop / gateway) ──
SHOP_ID=shop_001
GATEWAY_ID=gateway_001
SHOP_NAME=Inklink Print Shop
SHOP_DESCRIPTION=Local print shop on the Inklink network.
GATEWAY_MDNS=gateway-001.local
# Optional private IPv4 hint placed in the signed pairing QR.
GATEWAY_IP=

# ── Sessions ──
WEB_SESSION_TTL_SECONDS=7200
SESSION_TTL_SECONDS=900
# Shop dashboard access token. 32 random bytes as hex is fine.
SHOP_ADMIN_TOKEN=

# ── Pricing (INR per page) and HTS-USDC settlement ──
PRICE_PER_PAGE_MONOCHROME=2.00
PRICE_PER_PAGE_COLOR=10.00
# USDC per 1 INR. Leave empty to offer no Hedera settlement (quotes then have no payment method).
INR_TO_USDC_RATE=
FX_SOURCE_LABEL=configured rate
QUOTE_TTL_SECONDS=300

# ── Print operator (services/strands-agent) ──
AGENT_URL=http://127.0.0.1:4000
# Same value as AGENT_SERVICE_TOKEN in services/strands-agent/.env.
AGENT_SERVICE_TOKEN=

# ── Document engine and local printer adapter ──
DOCUMENT_ENGINE_URL=http://127.0.0.1:5001
PRINTER_AGENT_URL=http://127.0.0.1:7777
PRINTER_AGENT_TOKEN=

# ── Payment agent / x402 gate (services/payment-agent) ──
# The three shared secrets must be identical on the payment agent. Share them
# privately; never commit them.
PAYMENT_AGENT_URL=http://127.0.0.1:4021
GATE_URL=http://127.0.0.1:4022
INTERNAL_API_TOKEN=
BACKEND_API_TOKEN=
PAYMENT_EVENT_SIGNING_SECRET=
# Dedicated Hedera testnet merchant account (must differ from the agent account).
MERCHANT_ACCOUNT_ID=

# ── Native-app payment handoff ──
HANDOFF_TTL_SECONDS=900
HANDOFF_DEEP_LINK_BASE=inklink://pay
# ── Deployment (Cloud Run sets these; leave empty / default locally) ──
# direct = call PRINTER_AGENT_URL on this LAN; relay = the shop gateway connector polls in.
PRINTER_MODE=direct
GATEWAY_TOKEN=
PRINTER_RELAY_TIMEOUT_SECONDS=30
# File holding the 32-byte Ed25519 QR-signing seed (raw/hex/base64). Empty = DATA_DIR/gateway_ed25519.key.
GATEWAY_IDENTITY_KEY_PATH=
# https origin added (signed) to the shop QR so the native app can reach a cloud backend.
PUBLIC_API_ORIGIN=
# gcp-id-token = send Cloud Run ID tokens to the private agent / engine / payment agent.
SERVICE_AUTH=
# >0 coalesces state.json writes (seconds); flushed on shutdown.
STATE_SAVE_INTERVAL_SECONDS=0
# First shopkeeper on a server without a shell (never overwrites an existing account).
BOOTSTRAP_SHOPKEEPER_EMAIL=
BOOTSTRAP_SHOPKEEPER_NAME=
BOOTSTRAP_SHOPKEEPER_SHOPS=
BOOTSTRAP_SHOPKEEPER_PASSWORD=
