{
  "expo": {
    "name": "Inklink",
    "slug": "inklink",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "inklink",
    "userInterfaceStyle": "light",
    "backgroundColor": "#000000",
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Inklink scans a shop's QR code to connect to its local print gateway.",
          "recordAudioAndroid": false
        }
      ],
      "expo-document-picker",
      "expo-sqlite",
      "expo-status-bar",
      "expo-secure-store",
      "expo-build-properties",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#000000",
          "resizeMode": "contain",
          "imageWidth": 220
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.inklink.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Inklink scans a shop's QR code to connect to its local print gateway."
      }
    },
    "android": {
      "package": "com.inklink.app",
      "versionCode": 1,
      "permissions": ["CAMERA"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
