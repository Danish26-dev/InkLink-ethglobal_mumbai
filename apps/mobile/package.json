{
  "name": "@inklink/mobile",
  "version": "0.1.0",
  "description": "Inklink customer app — React Native + Expo + TypeScript. Local-first shop discovery, document submission, print config, payment selection, job tracking.",
  "license": "MIT",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json",
    "test": "node --test --import tsx ./test/*.test.ts",
    "headless": "tsx scripts/headless-flow.ts",
    "eas-build-post-install": "cd ../../packages/shared-schemas && npm ci --no-audit --no-fund && npm run build"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@inklink/shared-schemas": "file:../../packages/shared-schemas",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "expo": "^58.0.0",
    "expo-build-properties": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "~19.3.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "tsx": "4.23.15",
    "typescript": "~6.0.3"
  },
  "private": true
}
