# Inklink — environment overview (placeholders only; NEVER commit filled-in files).
#
# Secrets live in each SERVICE's own git-ignored .env, never in this file and
# never in React (VITE_*) variables. This file maps every variable to its home.
# See ENVIRONMENT_SETUP.md for what each one does and how to obtain it.
#
# ┌──────────────────────────────┬───────────────────────────────────────────┐
# │ File                         │ Holds                                     │
# ├──────────────────────────────┼───────────────────────────────────────────┤
# │ services/backend/.env        │ 0G keys, payment shared secrets, Galileo, │
# │                              │ device token, sessions (see its example)  │
# │ services/strands-agent/.env  │ AGENT_SERVICE_TOKEN, optional Vertex AI   │
# │ services/payment-agent/.env  │ Hedera agent account + key, merchant      │
# │ deploy/.env.gate             │ x402 gate (same Hedera / merchant values) │
# │ services/local-printer-agent/.env │ PRINTER_AGENT_TOKEN                  │
# └──────────────────────────────┴───────────────────────────────────────────┘

# ── services/backend/.env ─────────────────────────────────────────────
ZERO_G_BASE_URL=https://router-api.0g.ai/v1
ZERO_G_STANDARD_API_KEY=
ZERO_G_VERIFIED_API_KEY=
ZERO_G_PRIVATE_API_KEY=
ZERO_G_DEFAULT_TRUST_MODE=private
ZERO_G_MODEL_ID=glm-5.3
ZERO_G_TIMEOUT_SECONDS=180
ZERO_G_MAX_RETRIES=2
AGENT_SERVICE_TOKEN=
PRINTER_AGENT_TOKEN=
SHOP_ADMIN_TOKEN=
INTERNAL_API_TOKEN=
BACKEND_API_TOKEN=
PAYMENT_EVENT_SIGNING_SECRET=
MERCHANT_ACCOUNT_ID=
INR_TO_USDC_RATE=
DEVICE_TOKEN=
ZERO_G_GALILEO_RPC_URL=
ZERO_G_GALILEO_CHAIN_ID=
INKLINK_SHOP_REGISTRY_ADDRESS=
INKLINK_JOB_REGISTRY_ADDRESS=
INKLINK_SHOP_REGISTRY_ABI_PATH=
INKLINK_JOB_REGISTRY_ABI_PATH=
ZERO_G_GALILEO_SIGNER_PRIVATE_KEY=
ZERO_G_STORAGE_INDEXER_URL=

# ── services/strands-agent/.env ───────────────────────────────────────
INKLINK_MODEL_PROVIDER=0g-private-computer
# AGENT_SERVICE_TOKEN=   (same value as the backend)
# Optional, only if INKLINK_MODEL_PROVIDER=vertex-ai:
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
VERTEX_AI_MODEL_ID=

# ── services/payment-agent/.env and deploy/.env.gate ─────────────────
HEDERA_AGENT_ACCOUNT_ID=
HEDERA_AGENT_PRIVATE_KEY=
MERCHANT_ID=shop_001
# MERCHANT_ACCOUNT_ID=  INTERNAL_API_TOKEN=  PAYMENT_EVENT_SIGNING_SECRET=  BACKEND_API_TOKEN=  (same as the backend)
FACILITATOR_URL=https://api.testnet.blocky402.com
BACKEND_EVENT_URL=
REQUIREMENTS_URL_TEMPLATE=

# ── Contract deployment (your machine / CI only; never on the backend) ─
# The deployer private key is used only by the contract deploy tooling.
ZERO_G_GALILEO_DEPLOYER_PRIVATE_KEY=
