# Non-secret staging settings for deploy/gcp. Copy to deploy/gcp/env/staging.env
# (git-ignored) and adjust. Secrets never go here: use 05-configure-secrets.sh.
#
# The project id/number are fixed in lib.sh and cannot be overridden.

REGION=asia-south1

# Shop identity shown in the app and on the signed pairing QR.
SHOP_ID=shop_001
SHOP_NAME="Inklink Print Shop"
SHOP_DESCRIPTION="Local print shop on the Inklink network."
GATEWAY_ID=gateway_001

# First shopkeeper login, created at backend start if it does not exist yet.
# The password is the Secret Manager secret BOOTSTRAP_SHOPKEEPER_PASSWORD.
BOOTSTRAP_SHOPKEEPER_EMAIL=
BOOTSTRAP_SHOPKEEPER_NAME="Shop owner"
# true = reset that account's password to the secret on every backend start
# (use it to fix a wrong password; existing sessions are ended).
BOOTSTRAP_SHOPKEEPER_SYNC_PASSWORD=false

# ETHGlobal jury demo shop (isolated, never prints).
JURY_DEMO_ENABLED=true

# 0G Private Computer (keys are secrets; these are not).
ZERO_G_DEFAULT_TRUST_MODE=private
ZERO_G_MODEL_ID=glm-5.3

# Pricing (INR per page)
PRICE_PER_PAGE_MONOCHROME=2.00
PRICE_PER_PAGE_COLOR=10.00

# ── Hedera x402 payments (testnet). Leave empty to deploy without payments. ──
# Payment services are deployed only when these and every payment secret exist.
HEDERA_AGENT_ACCOUNT_ID=
MERCHANT_ID=shop_001
MERCHANT_ACCOUNT_ID=
# USDC per 1 INR, e.g. 0.012. Empty = Hedera settlement is not offered.
INR_TO_USDC_RATE=
FACILITATOR_URL=https://api.testnet.blocky402.com
# ── 0G Galileo InklinkRegistry (contracts/). Leave empty until deployed; records then stay queued. ──
# RPC and chain id from docs.0g.ai; the backend refuses to send if eth_chainId differs.
ZERO_G_GALILEO_RPC_URL=
ZERO_G_GALILEO_CHAIN_ID=
# Address printed by `npm run deploy:galileo` in contracts/. The writer key is the secret
# ZERO_G_GALILEO_SIGNER_PRIVATE_KEY (05-configure-secrets.sh).
INKLINK_REGISTRY_ADDRESS=
# HCS topic for the agent's signed spend audit log (topic id, not a secret).
# Created once by the payment agent owner with `npm run setup:audit-topic`.
HCS_AUDIT_TOPIC_ID=
