# Copy to .env.agent (git-ignored) and fill in. NEVER commit the filled-in file.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Shared with the Inklink backend
INTERNAL_API_TOKEN=
PAYMENT_EVENT_SIGNING_SECRET=

# The agent's Hedera testnet wallet. This is the ONLY place the private key lives.
HEDERA_AGENT_ACCOUNT_ID=
HEDERA_AGENT_PRIVATE_KEY=

# Shop receiving account (must differ from the agent account and have USDC associated)
MERCHANT_ID=shop_001
MERCHANT_ACCOUNT_ID=

# Where the signed settlement callback goes (the backend's public or private URL)
BACKEND_EVENT_URL=https://CHANGE-ME/api/v1/internal/payment-settled

FACILITATOR_URL=https://api.testnet.blocky402.com
