# Local docker compose secrets. Copy to the REPO ROOT as .env (git-ignored):
#   cp deploy/env/compose.env.example .env
# Generate each token with:  openssl rand -hex 32
# docker-compose.yml hands every container only the variables it needs.

# 0G Private Computer (backend only). Empty = the labelled deterministic operator.
ZERO_G_STANDARD_API_KEY=
ZERO_G_VERIFIED_API_KEY=
ZERO_G_PRIVATE_API_KEY=

# Shared service tokens
AGENT_SERVICE_TOKEN=
PRINTER_AGENT_TOKEN=
SHOP_ADMIN_TOKEN=
DEVICE_TOKEN=
# Only with PRINTER_MODE=relay (shop gateway connector)
GATEWAY_TOKEN=
PRINTER_MODE=direct
PRINTER_AGENT_URL=http://host.docker.internal:7777

# Payments (docker compose --profile payments)
INTERNAL_API_TOKEN=
BACKEND_API_TOKEN=
PAYMENT_EVENT_SIGNING_SECRET=
MERCHANT_ID=shop_001
MERCHANT_ACCOUNT_ID=
INR_TO_USDC_RATE=
HEDERA_AGENT_ACCOUNT_ID=
HEDERA_AGENT_PRIVATE_KEY=
FACILITATOR_URL=https://api.testnet.blocky402.com

JURY_DEMO_ENABLED=true
