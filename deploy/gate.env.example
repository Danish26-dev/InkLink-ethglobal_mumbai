# Copy to .env.gate (git-ignored) and fill in. NEVER commit the filled-in file.
# The gate prices jobs and never signs anything, so it does NOT get the agent's private key.

HEDERA_AGENT_ACCOUNT_ID=
# Required by the config loader but unused by the gate. Keep this placeholder.
HEDERA_AGENT_PRIVATE_KEY=unused-by-gate
MERCHANT_ID=shop_001
MERCHANT_ACCOUNT_ID=

# Ask the Inklink backend what each job must pay (backend-authoritative)
REQUIREMENTS_URL_TEMPLATE=https://CHANGE-ME/api/v1/internal/jobs/{jobId}/payment-requirements
BACKEND_API_TOKEN=

FACILITATOR_URL=https://api.testnet.blocky402.com
